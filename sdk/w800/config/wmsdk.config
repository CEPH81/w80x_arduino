
#
# SoC configuration
#

#
# W80X
#

#
# XT804
#
CONFIG_FLASH_BASE_ADDR=0x8000000
CONFIG_SRAM_BASE_ADDR=0x20000000
CONFIG_SRAM_LENGTH=0x28000
CONFIG_DRAM_BASE_ADDR=0x20028000
CONFIG_DRAM_LENGTH=0x20000
CONFIG_PSRAM_BASE_ADDR=0x30000000
CONFIG_PSRAM_MAX_LENGTH=0x800000
CONFIG_UART_BASE_ADDR=0x40010600
CONFIG_UART_LENGTH=0xA00
CONFIG_XT804_SEPARATE_IRQ_SP=y
CONFIG_XT804_ARCH_INTERRUPTSTACK=4096
CONFIG_XT804_IRQ_VECTOR_SIZE=256
CONFIG_XT804_SAVE_VR_REGISTERS=y
CONFIG_XT804_SAVE_HIGH_REGISTERS=y
CONFIG_XT804_SYSTEM_SECURE=y
CONFIG_XT804_TRAP_PRINT_STR=y
CONFIG_XT804_TRAP_OUTPUT_RAMDUMP=y
# end of XT804

CONFIG_W80X_BASIC_DRIVER=y

#
# Toolchain
#

#
# Path to the toolchain, see help for details
#
CONFIG_TOOLCHAIN_PATH=""

#
# Toolchain name prefix, see help for details
#
CONFIG_TOOLCHAIN_PREFIX="csky-elfabiv2-"
# end of Toolchain

CONFIG_BUILD_TYPE_W800=y
# CONFIG_BUILD_TYPE_W801S is not set
# CONFIG_BUILD_TYPE_W802 is not set
# CONFIG_BUILD_TYPE_W803 is not set
# CONFIG_BUILD_TYPE_W805 is not set
# CONFIG_BUILD_TYPE_W806 is not set
# end of W80X

CONFIG_CHIP_NAME="W800"
CONFIG_CHIP_W80X=y
CONFIG_CHIP_FAMILY_NAME="w80x"
CONFIG_CHIP_HAVE_RF=y
CONFIG_CHIP_HAVE_WIFI=y
CONFIG_CHIP_HAVE_BT=y
CONFIG_BUILD_VERSION="2.4-rc"
# end of SoC configuration

#
# Compiler configuration
#
# CONFIG_COMPILER_OPTIMIZE_LEVEL_O0 is not set
# CONFIG_COMPILER_OPTIMIZE_LEVEL_OS is not set
CONFIG_COMPILER_OPTIMIZE_LEVEL_O2=y
# CONFIG_COMPILER_OPTIMIZE_LEVEL_O3 is not set
CONFIG_COMPILER_DEBUG_INFORMATION=y
CONFIG_COMPILER_OPTIMIZE_CCACHE=y
# CONFIG_ATTRIBUTE_INLINE_ALWAYS is not set
# end of Compiler configuration

#
# Partition Table
#
CONFIG_COMPONENT_PARTITION_TABLE_ENABLED=y
# CONFIG_WM_PARTITION_TABLE_NORMAL_APP is not set
CONFIG_WM_PARTITION_TABLE_LARGE_APP=y
# CONFIG_WM_PARTITION_TABLE_WITH_OTA is not set
# CONFIG_WM_PARTITION_TABLE_CUSTOMIZATION is not set
CONFIG_WM_PARTITION_TABLE_OFFSET=0xE000
# end of Partition Table

#
# Components configuration
#
# CONFIG_COMPONENT_BT_ENABLED is not set

#
# Bootloader
#
# CONFIG_BOOTLOADER_LOG_LEVEL_NONE is not set
# CONFIG_BOOTLOADER_LOG_LEVEL_ERROR is not set
# CONFIG_BOOTLOADER_LOG_LEVEL_WARN is not set
CONFIG_BOOTLOADER_LOG_LEVEL_INFO=y
# CONFIG_BOOTLOADER_LOG_LEVEL_DEBUG is not set
# CONFIG_BOOTLOADER_LOG_LEVEL_VERBOSE is not set
CONFIG_BOOTLOADER_LOG_LEVEL=3
# CONFIG_BOOTLOADER_SKIP_ESC_CHECK is not set
# CONFIG_BOOTLOADER_SKIP_UPGRADE_CHECK is not set
# CONFIG_BOOTLOADER_SKIP_FIRMWARE_INTEGRITY_CHECK is not set
# end of Bootloader

# CONFIG_COMPONENT_CJSON_ENABLED is not set

#
# Cloud
#
# CONFIG_COMPONENT_AWS_ENABLED is not set
# end of Cloud

# CONFIG_COMPONENT_COAP_ENABLED is not set

#
# PERIPHERALS
#
CONFIG_COMPONENT_DRIVER_RCC_ENABLED=y
CONFIG_COMPONENT_DRIVER_PMU_ENABLED=y
CONFIG_COMPONENT_DRIVER_IRQ_ENABLED=y
CONFIG_COMPONENT_DRIVER_DMA_ENABLED=y
CONFIG_COMPONENT_DRIVER_INTERNAL_FLASH_ENABLED=y
# CONFIG_COMPONENT_DRIVER_EXTERNAL_FLASH_ENABLED is not set
CONFIG_COMPONENT_DRIVER_TIMER_ENABLED=y
CONFIG_COMPONENT_DRIVER_UART_ENABLED=y
CONFIG_COMPONENT_DRIVER_GPIO_ENABLED=y
# CONFIG_COMPONENT_DRIVER_PSRAM_ENABLED is not set
CONFIG_COMPONENT_DRIVER_PWM_ENABLED=y
CONFIG_COMPONENT_DRIVER_RTC_ENABLED=y
# CONFIG_COMPONENT_DRIVER_SDMMC_ENABLED is not set
# CONFIG_COMPONENT_DRIVER_SDSPI_ENABLED is not set
CONFIG_COMPONENT_DRIVER_SPIM_ENABLED=y
# CONFIG_COMPONENT_DRIVER_SPIS_ENABLED is not set
# CONFIG_COMPONENT_DRIVER_SPIM_SOFT_ENABLED is not set
CONFIG_COMPONENT_DRIVER_WDT_ENABLED=y
# CONFIG_COMPONENT_DRIVER_TOUCH_PANEL_ENABLED is not set
CONFIG_CONPONENT_DRIVER_TOUCH_PANEL_MAX_POINT=6
# CONFIG_COMPONENT_DRIVER_TFT_LCD_ENABLED is not set
CONFIG_COMPONENT_DRIVER_ADC_ENABLED=y
CONFIG_COMPONENT_DRIVER_CRC_ENABLED=y
CONFIG_COMPONENT_DRIVER_CRYPTO_ENABLED=y
CONFIG_COMPONENT_DRIVER_HASH_ENABLED=y
CONFIG_COMPONENT_DRIVER_RNG_ENABLED=y
CONFIG_COMPONENT_DRIVER_RSA_ENABLED=y
CONFIG_COMPONENT_DRIVER_I2S_ENABLED=y
CONFIG_COMPONENT_DRIVER_I2C_ENABLED=y
# CONFIG_COMPONENT_DRIVER_CODEC_ES8374_ENABLED is not set
# CONFIG_COMPONENT_DRIVER_SDIO_SLAVE_ENABLED is not set
# CONFIG_COMPONENT_DRIVER_HSPI_SLAVE_ENABLED is not set
# end of PERIPHERALS

# CONFIG_COMPONENT_FATFS_ENABLED is not set

#
# FreeRTOS
#
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=256
CONFIG_FREERTOS_MAX_TASK_NAME_LEN=16
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
# CONFIG_FREERTOS_ENABLE_RUN_TIME_STATS is not set
# CONFIG_FREERTOS_USE_TICKLESS_IDLE is not set
CONFIG_FREERTOS_ENABLE_IDLE_HOOK=y
# CONFIG_FREERTOS_ENABLE_TICK_HOOK is not set
CONFIG_FREERTOS_QUEUE_REGISTRY_SIZE=0
CONFIG_FREERTOS_TIMER_TASK_PRIORITY=15
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=512
CONFIG_FREERTOS_TIMER_QUEUE_LENGTH=128
CONFIG_FREERTOS_ENABLE_STATIC_TASK_CLEAN_UP=y
# CONFIG_FREERTOS_ASSERT_DISABLE is not set
CONFIG_FREERTOS_ASSERT_FAIL_ABORT=y
# CONFIG_FREERTOS_ASSERT_FAIL_PRINT_CONTINUE is not set
CONFIG_FREERTOS_CHECK_STACKOVERFLOW=y
# end of FreeRTOS

# CONFIG_COMPONENT_LITTLEFS_ENABLED is not set
# CONFIG_COMPONENT_LVGL_ENABLED is not set
CONFIG_COMPONENT_LWIP_ENABLED=y
CONFIG_LWIP_TCPIP_MBOX_SIZE=32
CONFIG_LWIP_TCP=y
CONFIG_LWIP_TCP_MAXRTX=3
CONFIG_LWIP_TCP_SYNMAXRTX=4
CONFIG_LWIP_TCP_MSS=1460
CONFIG_LWIP_TCP_WND_DEFAULT=8
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=6
CONFIG_LWIP_TCP_RECVMBOX_SIZE=10
CONFIG_LWIP_UDP=y
CONFIG_LWIP_UDP_RECVMBOX_SIZE=6
# CONFIG_LWIP_IP_FORWARD is not set
CONFIG_LWIP_ADD_AP_IF=y
# CONFIG_LWIP_ENABLE_DNS_SERVER is not set
CONFIG_LWIP_ENABLE_IPV4=y
# CONFIG_LWIP_ENABLE_IPV6 is not set
CONFIG_WM_LWIP=y
# CONFIG_LWIP_DEBUG is not set
# CONFIG_LWIP_NETBUF_RECVINFO is not set
CONFIG_LWIP_MAX_NTP_SERVERS=3

#
# NTP configuration
#
CONFIG_WM_NTP_SERVER1="ntp.sjtu.edu.cn"
CONFIG_WM_NTP_SERVER2="cn.ntp.org.cn"
CONFIG_WM_NTP_SERVER3="us.pool.ntp.org"
# end of NTP configuration

CONFIG_COMPONENT_MBEDTLS_ENABLED=y

#
# TLS maximum fragment length configuration
#
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
# end of TLS maximum fragment length configuration

CONFIG_MBEDTLS_ENABLE_HARD_DRV=y
# CONFIG_MBEDTLS_ENABLE_DEBUG is not set
# CONFIG_COMPONENT_MQTT_ENABLED is not set
# CONFIG_COMPONENT_POSIX_ENABLED is not set
# CONFIG_COMPONENT_WEBSOCKET_ENABLED is not set
# CONFIG_COMPONENT_WM_ATCMD_ENABLED is not set
# CONFIG_COMPONENT_CLI_ENABLED is not set

#
# Device Table
#
CONFIG_COMPONENT_DT_ENABLED=y
# CONFIG_DT_USE_C_STYLE_CONF is not set
# end of Device Table

CONFIG_COMPONENT_EVENT_ENABLED=y
CONFIG_WM_EVENT_USE_TASK=y
CONFIG_WM_EVENT_QUEUE_SIZE=32
CONFIG_COMPONENT_FT_PARAM_ENABLED=y
# CONFIG_WM_FT_PARAM_ENABLE_DATA_RESET_WHEN_GET is not set

#
# Heap
#
CONFIG_HEAP_USE_ASSERT=y
CONFIG_HEAP_USE_TRACING=y
# end of Heap

# CONFIG_COMPONENT_HTTP_CLIENT_ENABLED is not set

#
# Log
#
CONFIG_LOG_UART_PRINT_USE_UART0=y
# CONFIG_LOG_UART_PRINT_USE_UART1 is not set
# CONFIG_LOG_UART_PRINT_USE_UART2 is not set
# CONFIG_LOG_UART_PRINT_USE_UART3 is not set
# CONFIG_LOG_UART_PRINT_USE_UART4 is not set
CONFIG_LOG_PRINT_UART_PORT=0
CONFIG_LOG_PRINT_UART_DEVICE="uart0"
CONFIG_COMPONENT_LOG_ENABLED=y
# CONFIG_LOG_DEFAULT_LEVEL_NONE is not set
# CONFIG_LOG_DEFAULT_LEVEL_ERROR is not set
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# CONFIG_LOG_DEFAULT_LEVEL_INFO is not set
# CONFIG_LOG_DEFAULT_LEVEL_DEBUG is not set
# CONFIG_LOG_DEFAULT_LEVEL_VERBOSE is not set
CONFIG_LOG_DEFAULT_LEVEL=2
# CONFIG_LOG_USE_COLOR is not set
CONFIG_LOG_FORMAT_BUF_SIZE=256
# end of Log

CONFIG_COMPONENT_NET_MANAGER_ENABLED=y
CONFIG_COMPONENT_NM_WIFI_STA_ENABLED=y
CONFIG_NM_WIFI_STA_AUTO_CONNECT=y
CONFIG_NM_STA_RECONNECT_INTERVAL=1000
CONFIG_COMPONENT_NM_WIFI_SOFTAP_ENABLED=y
CONFIG_NM_WIFI_SOFTAP_AUTO_CHANNEL=y
CONFIG_NM_WIFI_SOFTAP_MAX_STA_CONN=8

#
# DHCP server configuration
#
CONFIG_NM_DHCPS_IP="192.168.10.1"
CONFIG_NM_DHCPS_NETMASK="255.255.255.0"
CONFIG_NM_DHCPS_GATEWAY="192.168.10.1"
CONFIG_NM_DHCPS_START_IP="192.168.10.2"
CONFIG_NM_DHCPS_LEASE_TIME=86400
# end of DHCP server configuration

CONFIG_WM_NETIF_SELECT_LWIP=y
CONFIG_COMPONENT_NVS_ENABLED=y
CONFIG_NVS_VER_NUM=0
# CONFIG_COMPONENT_OTA_ENABLED is not set

#
# Power Manager
#
# CONFIG_COMPONENT_PM_ENABLED is not set
# end of Power Manager

CONFIG_COMPONENT_RF_ENABLED=y
CONFIG_COMPONENT_WIFI_ENABLED=y
CONFIG_WIFI_MASCW_TX_BUF_NUM=7
CONFIG_WIFI_MASCW_RX_BUF_NUM=3
CONFIG_WIFI_API_ENABLED=y
CONFIG_WIFI_ENABLE_AP_FEATURE=y
CONFIG_WIFI_DHCPS_IPV4_ADDR="192.168.10.1"
CONFIG_WIFI_DHCPS_IPV4_NETMASK="255.255.255.0"
CONFIG_WIFI_DHCPS_IPV4_GW="192.168.10.1"
CONFIG_WIFI_NVS_ENABLED=y
CONFIG_COMPONENT_WPA_SUPPLICANT_ENABLED=y
CONFIG_WPA_SUPPLICANT_ENABLE_AP=y
CONFIG_WPA_SUPPLICANT_ENABLE_SAE=y
CONFIG_WPA_SUPPLICANT_HARD_CRYPTO_ENABLED=y
# CONFIG_WPA_SUPPLICANT_ENABLE_DEBUG is not set
# CONFIG_COMPONENT_YAML_ENABLED is not set
# end of Components configuration
